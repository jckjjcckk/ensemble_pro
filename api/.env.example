# Server-side secrets — never shipped to the browser. Copy to .env and fill in.

# Supabase dashboard → Settings → API Keys → "Secret key" (sb_secret_...). Bypasses RLS.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# LLM provider for vision + reasoning: "anthropic" while experimenting, "meta" for submission.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
META_API_KEY=
META_API_BASE_URL=

# Default per-user cap. The live cap is profiles.budget_usd; this seeds new rows.
PER_USER_BUDGET_USD=10

# Comma-separated origins allowed to call this API: the Vite dev server, the hosted web app, and the Capacitor
# iPad app (capacitor://localhost; ionic://localhost and http://localhost are the older and Android schemes).
CORS_ORIGINS=http://localhost:5173,https://folio.jckjjcckk.com,capacitor://localhost,ionic://localhost,http://localhost

# Model names per provider (defaults shown). Meta's base URL keeps its /v1; the client strips it for the SDK.
ANTHROPIC_MODEL=claude-opus-5-5
META_MODEL=muse-spark-1.3
