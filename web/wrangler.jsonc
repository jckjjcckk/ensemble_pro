{
  // The hosted web app: a Cloudflare Worker that serves web/dist as static assets (no Worker code of its own).
  // Build with `npm run build:hosted`, deploy with `npm run deploy:web` (scripts/deploy-web.sh). Custom domain
  // app.folio.jckjjcckk.com is added in the dashboard (deploy/README.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // React Router owns the paths: any unknown URL gets index.html with a 200.
    "not_found_handling": "single-page-application"
  }
}
